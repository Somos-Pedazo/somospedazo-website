---
import LegalLayout from '../layouts/LegalLayout.astro';
import { PAGINAS } from '../data/paginas';
---

<LegalLayout pagina={PAGINAS.cookies} actualizado="octubre de 2026">
  <h2>¿Usamos cookies?</h2>
  <p>
    Este sitio no instala cookies de análisis, publicidad ni redes sociales. Por eso no te mostramos ningún aviso de consentimiento.
  </p>

  <h2>Si esto cambia</h2>
  <p>
    Si en el futuro incorporamos herramientas que usen cookies no técnicas, actualizaremos esta página y te pediremos permiso antes de
    instalarlas.
  </p>
</LegalLayout>
