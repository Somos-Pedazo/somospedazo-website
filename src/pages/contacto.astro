---
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/ui/CabeceraPagina.astro';
import FormularioContacto from '../components/ui/FormularioContacto.astro';
import { PAGINAS } from '../data/paginas';

const pagina = PAGINAS.contacto;
---

<BaseLayout pagina={pagina} tipoPagina="ContactPage">
  <CabeceraPagina pagina={pagina} antetitulo="Contacto" titulo="Cuéntanos tu proyecto.">
    <p>Dinos dónde estás y adónde quieres llegar. Te respondemos con una propuesta de primer paso, sin compromiso.</p>
  </CabeceraPagina>

  <div class="seccion seccion--pegada">
    <div class="contenedor">
      <section class="contacto__formulario" aria-labelledby="formulario-titulo">
        <h2 id="formulario-titulo">Escríbenos</h2>
        <FormularioContacto />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .seccion--pegada {
    padding-block-start: var(--s-2);
  }

  .contacto__formulario {
    max-width: 48rem;
    padding: var(--s-4);
    border-radius: calc(var(--radio) * 1.4);
    background: color-mix(in srgb, var(--c-blanco) 60%, var(--c-crema));
  }

  .contacto__formulario h2 {
    font-size: var(--t-xl);
    margin-block-end: var(--s-3);
  }
</style>
