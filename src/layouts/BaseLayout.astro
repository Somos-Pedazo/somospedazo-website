---
import '../styles/global.css';
import Fonts from '../components/brand/Fonts.astro';
import SEO from '../components/seo/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE } from '../config/site';
import { COOKIEBOT_ID, COOKIEBOT_UC } from '../config/cookiebot';
import { MOTION_INIT } from '../scripts/motion/base';
import type { Pagina } from '../data/paginas';
import { breadcrumb, grafo, localBusiness, organization, webPage, website } from '../utils/schema';
// Vercel Web Analytics lo inyecta el adaptador (astro.config.mjs → webAnalytics), no un componente.

interface Props {
  pagina: Pagina;
  /** Nodos schema.org extra para esta página (Service, FAQPage…). */
  schema?: Record<string, unknown>[];
  /** Tipo de WebPage (ContactPage, AboutPage…). */
  tipoPagina?: string;
  /** Activa las animaciones ligadas al scroll (solo Inicio, Servicios y Enfoque). */
  motion?: boolean;
}

// Cookiebot (uc.js) va SIEMPRE como primer elemento del <head>, sin nada delante: tiene que cargar
// el primero para poder bloquear al resto de scripts hasta el consentimiento (src/config/cookiebot.ts).

const { pagina, schema = [], tipoPagina, motion = false } = Astro.props;
const jsonLd = grafo([organization(), localBusiness(), website(), webPage(pagina, tipoPagina), breadcrumb(pagina), ...schema]);
---

<!doctype html>
<html lang={SITE.locale} dir="ltr">
  <head>
    <script is:inline id="Cookiebot" src={COOKIEBOT_UC} data-cbid={COOKIEBOT_ID} data-blockingmode="auto" data-culture="ES" type="text/javascript"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fonts />
    <SEO pagina={pagina} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    {
      /* Antes de pintar nada: activa el modo animado si procede (src/scripts/motion/base.ts). */
      motion && <script is:inline data-cookieconsent="ignore" set:html={MOTION_INIT} />
    }
    <a class="salto" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
  </body>
</html>

<style is:global>
  .salto {
    position: absolute;
    inset-inline-start: var(--s-2);
    inset-block-start: -10rem;
    z-index: 100;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radio-pildora);
    background: var(--c-navy);
    color: var(--c-crema);
    font-family: var(--font-titular);
    font-weight: var(--peso-fuerte);
    text-decoration: none;
  }

  .salto:focus {
    inset-block-start: var(--s-2);
    --focus: var(--c-sol);
  }

  main:focus {
    outline: none;
  }
</style>
