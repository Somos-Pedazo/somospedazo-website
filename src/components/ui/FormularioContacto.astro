---
/**
 * Formulario de contacto → /api/contact (Turnstile + reenvío a Zoho CRM en servidor).
 *
 * - Marcado y estilos propios. Los nombres de campo son los de Zoho (src/config/zoho.ts);
 *   los campos ocultos de Zoho los añade el servidor (src/server/zoho.ts).
 * - Validación con mensajes propios, envío por fetch y mensaje de éxito sin salir
 *   de la web (src/scripts/formulario/).
 * - El botón está deshabilitado hasta que Turnstile emite un token. Sin JS no hay
 *   captcha, así que el formulario no puede enviarse: se muestra un aviso.
 * - Casillas: privacidad (obligatoria, el servidor la exige) y newsletter (opcional). Su valor
 *   y la fecha y hora se registran en «Description»; no se envían a Zoho como campos sueltos.
 * - Atribución: campos ocultos que el controlador rellena justo antes de enviar
 *   (src/scripts/atribucion.ts). El servidor los valida y compone Description y Lead Source.
 */
import { SITE } from '../../config/site';
import { CAMPOS, CAMPO_NEWSLETTER, CAMPO_PRIVACIDAD, HONEYPOT, TURNSTILE_SITE_KEY } from '../../config/zoho';
import { CAMPOS_ATRIBUCION, CAMPO_SUBMISSION_URL } from '../../config/atribucion';
---

<form
  class="formulario"
  id="formulario-contacto"
  method="post"
  action="/api/contact"
  accept-charset="UTF-8"
  data-formulario-contacto
  data-exito="formulario-exito"
  aria-describedby="formulario-ayuda"
>
  <noscript>
    <p class="formulario__noscript">Para enviar el formulario necesitas activar JavaScript en tu navegador.</p>
  </noscript>

  <!-- Atribución de marketing: se rellenan al enviar (src/scripts/formulario/index.ts). -->
  {[CAMPO_SUBMISSION_URL, ...CAMPOS_ATRIBUCION].map((c) => <input type="hidden" name={c} value="" data-atribucion={c} />)}

  <p id="formulario-ayuda" class="formulario__ayuda">
    Los campos marcados con <span aria-hidden="true">*</span><span class="sr-only">asterisco</span> son obligatorios.
  </p>

  <div class="formulario__rejilla">
    <div class="campo">
      <label for="nombre">Nombre <span aria-hidden="true">*</span></label>
      <input
        id="nombre"
        name={CAMPOS.nombre.name}
        data-etiqueta="nombre"
        type="text"
        autocomplete="given-name"
        required
        maxlength={CAMPOS.nombre.max}
        aria-describedby="nombre-error"
      />
      <p id="nombre-error" class="campo__error" hidden></p>
    </div>

    <div class="campo">
      <label for="apellidos">Apellidos <span aria-hidden="true">*</span></label>
      <input
        id="apellidos"
        name={CAMPOS.apellidos.name}
        data-etiqueta="apellidos"
        type="text"
        autocomplete="family-name"
        required
        maxlength={CAMPOS.apellidos.max}
        aria-describedby="apellidos-error"
      />
      <p id="apellidos-error" class="campo__error" hidden></p>
    </div>

    <div class="campo">
      <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
      <input
        id="email"
        name={CAMPOS.email.name}
        data-etiqueta="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        required
        maxlength={CAMPOS.email.max}
        aria-describedby="email-error"
      />
      <p id="email-error" class="campo__error" hidden></p>
    </div>

    <div class="campo">
      <label for="empresa">Empresa <span class="campo__opcional">(opcional)</span></label>
      <input id="empresa" name={CAMPOS.empresa.name} type="text" autocomplete="organization" maxlength={CAMPOS.empresa.max} />
    </div>

    <div class="campo campo--ancho">
      <label for="telefono">Teléfono <span class="campo__opcional">(opcional)</span></label>
      <input
        id="telefono"
        name={CAMPOS.telefono.name}
        data-etiqueta="telefono"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        maxlength={CAMPOS.telefono.max}
        pattern="[\d\s\(\)\+\-]{9,30}"
        aria-describedby="telefono-ayuda telefono-error"
      />
      <p id="telefono-ayuda" class="campo__ayuda">Solo si prefieres que te llamemos.</p>
      <p id="telefono-error" class="campo__error" hidden></p>
    </div>

    <div class="campo campo--ancho">
      <label for="mensaje">Cuéntanos tu proyecto <span aria-hidden="true">*</span></label>
      <textarea
        id="mensaje"
        name={CAMPOS.mensaje.name}
        data-etiqueta="mensaje"
        rows="6"
        required
        minlength="10"
        maxlength={CAMPOS.mensaje.max}
        aria-describedby="mensaje-ayuda mensaje-error"></textarea>
      <p id="mensaje-ayuda" class="campo__ayuda">¿Qué quieres conseguir? ¿Qué te frena ahora mismo? Con dos líneas nos vale.</p>
      <p id="mensaje-error" class="campo__error" hidden></p>
    </div>

    <!-- Honeypot antispam: debe llegar vacío. Oculto para personas y lectores de pantalla. -->
    <input class="campo--trampa" type="text" name={HONEYPOT} value="" tabindex="-1" autocomplete="off" aria-hidden="true" data-honeypot />

    <!-- Casilla 1 · obligatoria, sin premarcar. El servidor la exige y registra la fecha y hora. -->
    <div class="campo campo--ancho">
      <div class="campo--casilla">
        <input id="privacidad" name={CAMPO_PRIVACIDAD} value="si" data-etiqueta="privacidad" type="checkbox" required aria-describedby="privacidad-error" />
        <label for="privacidad">
          He leído y acepto la <a href="/privacidad">Política de privacidad</a>. <span aria-hidden="true">*</span>
        </label>
      </div>
      <p id="privacidad-error" class="campo__error" hidden></p>
    </div>

    <!--
      Casilla 2 · newsletter: opcional, sin premarcar e independiente de la anterior (no condiciona el envío).
      El servidor guarda su valor en el lead de Zoho con fecha y hora (src/pages/api/contact.ts).
    -->
    <div class="campo campo--ancho">
      <div class="campo--casilla">
        <input id="newsletter" name={CAMPO_NEWSLETTER} value="si" type="checkbox" />
        <label for="newsletter">
          Quiero recibir la newsletter y comunicaciones comerciales de Somos Pedazo. Puedes darte de baja cuando quieras. <span
            class="campo__opcional">(opcional)</span
          >
        </label>
      </div>
    </div>
  </div>

  <!-- Primera capa de información sobre protección de datos (texto facilitado por Somos Pedazo). -->
  <p class="formulario__rgpd">
    <strong>Responsable:</strong> Somos Pedazo. <strong>Finalidad:</strong> responder a tu consulta y, si lo aceptas, enviarte nuestra
    newsletter. <strong>Legitimación:</strong> tu solicitud y tu consentimiento. <strong>Destinatarios:</strong> proveedores tecnológicos que
    actúan por cuenta nuestra, algunos con transferencias internacionales con garantías adecuadas. <strong>Derechos:</strong> acceso,
    rectificación, supresión y otros, escribiendo a <a href={`mailto:${SITE.emailPrivacidad}`}>{SITE.emailPrivacidad}</a>. Más información
    en nuestra <a href="/privacidad">Política de privacidad</a>.
  </p>

  <!-- Cloudflare Turnstile (Managed). Renderizado explícito: src/scripts/formulario/turnstile.ts -->
  <div class="formulario__captcha">
    <div data-turnstile data-sitekey={TURNSTILE_SITE_KEY}></div>
    <p id="captcha-ayuda" class="campo__ayuda" data-turnstile-ayuda aria-live="polite">
      El botón se activará cuando se complete la verificación de seguridad.
    </p>
  </div>

  <div class="formulario__acciones">
    <button type="submit" class="formulario__enviar" disabled aria-describedby="captcha-ayuda">Enviar mensaje</button>
  </div>

  <p class="formulario__estado" data-estado role="status" aria-live="polite"></p>
</form>

<!--
  Turnstile es estrictamente necesario para enviar el formulario (política de cookies, apartado 3):
  se excluye del bloqueo automático de Cookiebot con data-cookieconsent="ignore".
-->
<script is:inline data-cookieconsent="ignore">
  // Callback de Cloudflare: avisa al controlador (src/scripts/formulario/turnstile.ts).
  window.onTurnstileListo = function () {
    window.__turnstileListo = true;
    document.dispatchEvent(new Event('turnstile:listo'));
  };
  // El script de Turnstile (async + defer) se pide tras el evento load, para que no
  // compita con el primer pintado de la página (LCP).
  (function () {
    function cargar() {
      var s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileListo';
      s.async = true;
      s.defer = true;
      s.setAttribute('data-cookieconsent', 'ignore');
      document.head.appendChild(s);
    }
    if (document.readyState === 'complete') cargar();
    else window.addEventListener('load', cargar, { once: true });
  })();
</script>

<div id="formulario-exito" class="formulario__exito" tabindex="-1" hidden>
  <p class="formulario__exito-titulo">¡Recibido! Ya tenemos tu pedazo.</p>
  <p>Gracias por contarnos tu proyecto. Lo leemos con calma y te escribimos muy pronto para ver por dónde empezar.</p>
  <button type="button" class="formulario__otro" data-otro>Enviar otro mensaje</button>
</div>

<script>
  import '../../scripts/formulario';
</script>

<style>
  .formulario {
    display: grid;
    gap: var(--s-3);
  }

  .formulario__ayuda,
  .campo__ayuda,
  .campo__opcional,
  .formulario__rgpd {
    font-size: var(--t-xs);
    color: var(--fg-suave);
  }

  .formulario__rejilla {
    display: grid;
    gap: var(--s-3);
  }

  .campo {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .campo label {
    font-family: var(--font-titular);
    font-weight: var(--peso-demi);
  }

  .campo input:not([type='checkbox']),
  .campo textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 1rem;
    border: 2px solid var(--c-navy);
    border-radius: 0.875rem;
    background: var(--c-blanco);
    color: var(--c-navy);
  }

  .campo textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .campo input:focus-visible,
  .campo textarea:focus-visible {
    outline: 3px solid var(--c-mandarina);
    outline-offset: 2px;
  }

  /* Sin JS: estilo nativo tras interactuar. Con JS: aria-invalid. */
  .campo input:user-invalid,
  .campo textarea:user-invalid,
  .campo [aria-invalid='true'] {
    border-color: var(--c-error);
    border-width: 3px;
  }

  .campo__error {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    color: var(--c-error);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .campo__error::before {
    content: '!' / '';
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: var(--radio-pildora);
    background: var(--c-error);
    color: var(--c-blanco);
    font-size: 0.75rem;
    line-height: 1;
    translate: 0 0.15rem;
  }

  .campo--casilla {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--s-2);
  }

  .campo--casilla input {
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.15rem;
    accent-color: var(--c-navy);
  }

  .campo--casilla input[aria-invalid='true'] {
    outline: 3px solid var(--c-error);
    outline-offset: 2px;
  }

  .campo--casilla label {
    font-family: var(--font-texto);
    font-weight: 400;
  }

  .campo--trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .formulario__enviar,
  .formulario__otro {
    min-height: 3.25rem;
    padding: 0.75rem 2rem;
    border: 3px solid var(--c-navy);
    border-radius: var(--radio-pildora);
    background: var(--c-navy);
    color: var(--c-crema);
    font-family: var(--font-titular);
    font-weight: var(--peso-fuerte);
    cursor: pointer;
    transition: transform var(--transicion);
  }

  .formulario__enviar:hover:not(:disabled),
  .formulario__otro:hover {
    transform: translateY(-2px);
  }

  .formulario__enviar:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .formulario[aria-busy='true'] .formulario__enviar {
    cursor: progress;
    opacity: 0.75;
  }

  /* Hueco reservado para Turnstile (65 px en tamaño normal/flexible): evita saltos de maquetación. */
  .formulario__captcha {
    display: grid;
    gap: var(--s-1);
  }

  .formulario__captcha [data-turnstile] {
    min-height: 65px;
  }

  .formulario__noscript {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radio);
    background: var(--c-chicle);
    font-weight: 700;
  }

  .formulario__estado:not(:empty) {
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radio);
    background: var(--c-sol);
    font-weight: 700;
  }

  .formulario__estado[data-tono='error']:not(:empty) {
    background: var(--c-chicle);
  }

  .formulario__exito {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding: var(--s-4);
    border-radius: var(--radio);
    background: var(--c-sol);
  }

  .formulario__exito:focus-visible {
    outline-offset: 4px;
  }

  .formulario__exito-titulo {
    font-family: var(--font-titular);
    font-weight: var(--peso-impacto);
    font-size: var(--t-xl);
    line-height: 1.15;
  }

  .formulario__otro {
    margin-block-start: var(--s-1);
    background: transparent;
    color: var(--c-navy);
  }

  @media (min-width: 40rem) {
    .formulario__rejilla {
      grid-template-columns: 1fr 1fr;
    }

    .campo--ancho {
      grid-column: 1 / -1;
    }
  }
</style>
