---
interface Props {
  href: string;
  /** `claro`: para fondos oscuros (navy). */
  variante?: 'primario' | 'secundario' | 'sol' | 'claro';
  /** Llamada a la acción principal: se acerca al cursor (src/scripts/hero-v2/micro.ts). */
  magnetico?: boolean;
  class?: string;
}

const { href, variante = 'primario', magnetico = false, class: className } = Astro.props;
---

<a href={href} class:list={['boton', `boton--${variante}`, className]} data-magnetico={magnetico ? '' : undefined}
  ><span class="boton__texto"><slot /></span></a
>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: 3.25rem;
    padding: 0.75rem 1.75rem;
    border: 3px solid var(--c-navy);
    border-radius: var(--radio-pildora);
    font-family: var(--font-titular);
    font-weight: var(--peso-fuerte);
    font-size: var(--t-sm);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    /* Solo transform: el cambio de color es instantáneo, sin repintados animados. */
    transition: transform var(--transicion);
  }

  .boton__texto {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  /* Mientras el imán sigue al cursor, el script mueve el botón: sin transición CSS que lo retrase. */
  .boton[data-iman-activo] {
    transition: none;
  }

  .boton:hover,
  .boton:focus-visible {
    transform: translateY(-2px);
  }

  .boton:active {
    transform: translateY(0) scale(0.98);
  }

  .boton--primario {
    background: var(--c-navy);
    color: var(--c-crema);
  }

  .boton--secundario {
    background: transparent;
    color: var(--c-navy);
  }

  .boton--secundario:hover {
    background: var(--c-sol);
  }

  .boton--sol {
    background: var(--c-sol);
    border-color: var(--c-sol);
    color: var(--c-navy);
  }

  .boton--claro {
    background: transparent;
    border-color: var(--c-crema);
    color: var(--c-crema);
  }

  .boton--claro:hover {
    background: var(--c-crema);
    color: var(--c-navy);
  }
</style>
