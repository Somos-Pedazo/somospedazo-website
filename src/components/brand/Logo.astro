---
/**
 * PLACEHOLDER LOGO
 * Logotipo provisional: «Somos Pedazo» en la tipografía de titular + un pedazo.
 * Cuando llegue el archivo definitivo:
 *  1. Copia el SVG a src/assets/logo.svg.
 *  2. Sustituye el marcado de abajo por: <Logo /> importado con
 *     `import LogoSvg from '../../assets/logo.svg'` y <LogoSvg aria-hidden="true" />.
 *  3. Mantén el texto accesible (aria-label del enlace en Header/Footer).
 */
interface Props {
  /** Variante para fondo claro (navy) u oscuro (crema). */
  tono?: 'claro' | 'oscuro';
  class?: string;
}

const { tono = 'claro', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${tono}`, className]} data-placeholder="logo">
  <svg class="logo__pieza" viewBox="0 0 40 24" width="40" height="24" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="26" height="22" rx="11" fill="#FFD500"></rect>
    <rect x="29" y="1" width="10" height="22" rx="5" fill="#FF8936"></rect>
  </svg>
  <span class="logo__texto">Somos Pedazo</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-titular);
    font-weight: var(--peso-impacto);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .logo__pieza {
    width: 1.65em;
    height: auto;
    flex: none;
  }

  .logo--claro {
    color: var(--c-navy);
  }

  .logo--oscuro {
    color: var(--c-crema);
  }
</style>
