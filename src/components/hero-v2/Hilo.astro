---
/**
 * Hilo conductor: un único pedazo que acompaña el scroll desde el hero hasta la escalera de
 * servicios por un trayecto suave (MotionPath), por los márgenes, sin tapar texto. Al llegar,
 * la escalera se construye (la misma animación de /servicios: src/scripts/motion/escalera.ts).
 * Solo escritorio con el modo animado; sin JS o con reduced motion no existe. Decorativo.
 */
---

<div class="hilo" aria-hidden="true" data-hilo>
  <span class="hilo__pieza" data-hilo-pieza></span>
</div>

<script>
  import '../../scripts/hero-v2/hilo';
  import '../../scripts/motion/escalera';
</script>

<style>
  .hilo {
    display: none;
    position: absolute;
    left: 0;
    width: 100%;
    height: 0;
    z-index: 3;
    pointer-events: none;
  }

  .hilo__pieza {
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 1.5rem;
    margin: -0.75rem 0 0 -1.5rem;
    border-radius: var(--radio-pildora);
    background: var(--c-mandarina);
    opacity: 0;
    will-change: transform;
  }

  @media (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
    :global(html.motion) .hilo {
      display: block;
    }
  }
</style>
