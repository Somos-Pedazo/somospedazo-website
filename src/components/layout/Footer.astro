---
import Logo from '../brand/Logo.astro';
import { LEGAL_NAV, NAV, SITE } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="pie oscuro">
  <div class="contenedor pie__principal">
    <div class="pie__marca">
      <a href="/" class="pie__logo" aria-label={`${SITE.name}, ir al inicio`}>
        <Logo tono="oscuro" />
      </a>
      <p class="pie__lema">{SITE.slogan}</p>
    </div>

    <nav aria-label="Pie de página">
      <ul class="pie__lista pie__lista--principal" role="list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="contenedor pie__legal">
    <p>© {year} {SITE.legalName}</p>
    <nav aria-label="Legal">
      <ul class="pie__lista" role="list">
        {
          LEGAL_NAV.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .pie {
    padding-block: var(--s-8) var(--s-4);
    margin-block-start: auto;
  }

  .pie a {
    color: var(--c-crema);
  }

  /* Marca a la izquierda y enlaces a la derecha; en móvil, uno debajo del otro. */
  .pie__principal {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4) var(--s-8);
  }

  .pie__logo {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .pie__lema {
    margin-block-start: var(--s-2);
    font-family: var(--font-titular);
    font-weight: var(--peso-demi);
    max-width: 22rem;
  }

  .pie__lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    padding: 0;
    list-style: none;
  }

  .pie__lista a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .pie__lista--principal {
    gap: 0 var(--s-4);
    font-family: var(--font-titular);
    font-weight: var(--peso-demi);
    font-size: var(--t-lg);
  }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-3);
    border-top: 1px solid color-mix(in srgb, var(--c-crema) 25%, transparent);
    font-size: var(--t-xs);
  }
</style>
