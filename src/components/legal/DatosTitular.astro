---
/**
 * Datos del titular / responsable en los textos legales. Salen de src/config/site.ts.
 * Mientras la sociedad no esté constituida, los datos que faltan se publican con un marcador
 * entre corchetes ([Razón social pendiente de constitución], [pendiente]). Al rellenarlos en
 * site.ts, los marcadores desaparecen solos.
 */
import { SITE } from '../../config/site';

interface Props {
  modo: 'aviso' | 'privacidad';
}

const { modo } = Astro.props;
const { legal, address: a } = SITE;
const PENDIENTE = '[pendiente]';
const titular = SITE.legalName || '[Razón social pendiente de constitución]';
const domicilio = a ? `${a.streetAddress}, ${a.postalCode} ${a.addressLocality} (${a.addressRegion})` : PENDIENTE;
---

<ul>
  {
    modo === 'aviso' ? (
      <>
        <li>
          <strong>Titular:</strong> {titular}
        </li>
        <li>
          <strong>Nombre comercial:</strong> {SITE.name}
        </li>
        <li>
          <strong>NIF:</strong> {legal.nif || PENDIENTE}
        </li>
        <li>
          <strong>Domicilio:</strong> {domicilio}
        </li>
        <li>
          <strong>Correo electrónico:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        {legal.registro && (
          <li>
            <strong>Datos registrales:</strong> {legal.registro}
          </li>
        )}
      </>
    ) : (
      <>
        <li>
          <strong>Responsable:</strong> {titular} (nombre comercial: {SITE.name})
        </li>
        {legal.nif && (
          <li>
            <strong>NIF:</strong> {legal.nif}
          </li>
        )}
        {a && (
          <li>
            <strong>Domicilio:</strong> {domicilio}
          </li>
        )}
        <li>
          <strong>Contacto para privacidad:</strong> <a href={`mailto:${SITE.emailPrivacidad}`}>{SITE.emailPrivacidad}</a>
        </li>
      </>
    )
  }
</ul>
