---
/**
 * Datos identificativos del titular (LSSI art. 10 y RGPD art. 13). Salen de src/config/site.ts.
 * El domicilio no se muestra por decisión del titular. La LSSI lo exige en el aviso legal:
 * cuando se quiera añadir, va aquí (datos en SITE.address).
 */
import { SITE } from '../../config/site';

const { legal } = SITE;
---

<dl>
  <dt>Titular</dt>
  <dd>{SITE.legalName}</dd>
  {
    legal.nif && (
      <>
        <dt>NIF</dt>
        <dd>{legal.nif}</dd>
      </>
    )
  }
  <dt>Correo electrónico</dt>
  <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
  {
    legal.registro && (
      <>
        <dt>Datos registrales</dt>
        <dd>{legal.registro}</dd>
      </>
    )
  }
  <dt>Sitio web</dt>
  <dd>{new URL(SITE.url).host}</dd>
</dl>
