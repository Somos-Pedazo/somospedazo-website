---
/**
 * Datos del titular / responsable en los textos legales. Salen de src/config/site.ts.
 * Cada línea solo se muestra si el dato existe (sin marcadores [ ] publicados).
 * El domicilio no se muestra mientras SITE.address esté vacío (la LSSI lo exige en el aviso legal).
 */
import { SITE } from '../../config/site';

interface Props {
  modo: 'aviso' | 'privacidad';
}

const { modo } = Astro.props;
const { legal, address: a } = SITE;
const domicilio = a ? `${a.streetAddress}, ${a.postalCode} ${a.addressLocality} (${a.addressRegion})` : '';
---

<ul>
  {
    modo === 'aviso' ? (
      <>
        <li>
          <strong>Titular:</strong> {SITE.legalName}
        </li>
        <li>
          <strong>Nombre comercial:</strong> {SITE.name}
        </li>
      </>
    ) : (
      <li>
        <strong>Responsable:</strong> {SITE.legalName}
      </li>
    )
  }
  {
    legal.nif && (
      <li>
        <strong>NIF:</strong> {legal.nif}
      </li>
    )
  }
  {
    domicilio && (
      <li>
        <strong>Domicilio:</strong> {domicilio}
      </li>
    )
  }
  {
    modo === 'aviso' ? (
      <li>
        <strong>Correo electrónico:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </li>
    ) : (
      <li>
        <strong>Contacto para privacidad:</strong> <a href={`mailto:${SITE.emailPrivacidad}`}>{SITE.emailPrivacidad}</a>
      </li>
    )
  }
  {
    modo === 'aviso' && legal.registro && (
      <li>
        <strong>Datos registrales:</strong> {legal.registro}
      </li>
    )
  }
</ul>
