---
import { SITE, absoluteUrl } from '../../config/site';
import type { Pagina } from '../../data/paginas';

interface Props {
  pagina: Pagina;
}

const { pagina } = Astro.props;
const { title, description, noindex } = pagina;

// Control de calidad en build: avisa si un título o descripción se sale de rango.
if (title.length > 60) console.warn(`[SEO] Título largo (${title.length}) en ${pagina.path}: «${title}»`);
if (description.length < 120 || description.length > 160)
  console.warn(`[SEO] Descripción fuera de rango (${description.length}) en ${pagina.path}`);

const canonical = absoluteUrl(pagina.path);
const ogImage = absoluteUrl(`/og/${pagina.slug}.png`);
const ogAlt = `${pagina.ogTitulo} · ${SITE.name}`;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{
  !noindex && (
    <>
      <link rel="canonical" href={canonical} />
      <link rel="alternate" hreflang="es-ES" href={canonical} />
      <link rel="alternate" hreflang="x-default" href={canonical} />
    </>
  )
}
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
