# Copia este archivo como .env para desarrollo local. No pongas aquí valores reales.

# Cloudflare Turnstile · site key (pública). En producción, si no se define, se usa la del código.
# En local, usa la de prueba de Cloudflare: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile · secret key. En producción está en Vercel (tipo Secret).
# En local, usa la de prueba de Cloudflare: 1x0000000000000000000000000000000AA
# (2x0000000000000000000000000000000AA fuerza un fallo de verificación, útil para probar errores).
TURNSTILE_SECRET_KEY=

# Opcional, solo para pruebas: envía los leads a otra URL en lugar de Zoho
# (por ejemplo, un servidor local que los registre) para no crear leads reales.
ZOHO_WEB_TO_LEAD_URL=
